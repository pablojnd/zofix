{
    "$schema": "https://opencode.ai/config.json",
    "lsp": {
        "laravel-lsp": {
            "command": [
                "laravel-lsp"
            ],
            "extensions": [
                ".php",
                ".blade.php"
            ]
        }
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ],
            "enabled": true
        },
        "codebase-memory-mcp": {
            "type": "local",
            "command": [
                "/home/orca/.local/bin/codebase-memory-mcp"
            ],
            "cwd": "/home/orca/workspace/laravel/zofix",
            "environment": {
                "CBM_ALLOWED_ROOT": "/home/orca/workspace/laravel/zofix"
            },
            "enabled": true
        }
    },
    "provider": {
        "bai": {
            "models": {
                "qwen3.8-flash": {
                    "id": "qwen3.8-flash",
                    "name": "Qwen 3.8 Flash",
                    "reasoning": true,
                    "temperature": true,
                    "limit": {
                        "context": 1000000,
                        "output": 65536
                    },
                    "options": {
                        "reasoning_effort": "max",
                        "temperature": 1,
                        "thinking": {
                            "clear_thinking": false,
                            "type": "enabled"
                        },
                        "top_p": 0.95
                    }
                }
            },
            "name": "B.ai",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "apiKey": "{env:BAI_API_KEY}",
                "baseURL": "{env:BAI_API_BASE_URL}"
            }
        }
    }
}
